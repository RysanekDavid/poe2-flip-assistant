# Copy to /opt/poe2flip/.coach.env, fill locally, then chmod 600.
# This allowlist is the entire environment visible to the Coach service.
NODE_ENV=production
COACH_PROXY_SECRET=
OPENAI_API_KEY=
TAVILY_API_KEY=
# Model and latency policy are release-managed in deploy/runtime-timeouts.env.
EMBEDDING_MODEL=text-embedding-3-small
POE_DB_PATH=/opt/poe2flip/data/poe2flip.db
POE2_DATA_MANIFEST=/opt/poe2flip/current/src/data/poe2/repoe/manifest.json
POE2_PATCH_COVERAGE=/opt/poe2flip/current/src/data/poe2/patch-coverage.json
PATCH_NOTES_MAX_READY_AGE_MIN=90
COACH_REQUESTS_PER_MINUTE=20
