[Unit]
Description=PoE2 Flip Assistant - web (Next.js)
Wants=poe2flip-coach.service
After=network.target poe2flip-coach.service

[Service]
Type=simple
User=poe2flip
Group=poe2flip
WorkingDirectory=/opt/poe2flip/current
# All secrets + config live here (chmod 600). Copied from deploy/.env.production.example.
# Named .env.local so the standalone scripts (db:migrate, addUser) load it via dotenv too.
EnvironmentFile=/opt/poe2flip/.env.local
Environment=NODE_ENV=production
Environment=PORT=3000
Environment=PATH=/usr/bin:/usr/local/bin
ExecStart=/usr/bin/npm run start -- --hostname 127.0.0.1
Restart=on-failure
RestartSec=5

[Install]
WantedBy=multi-user.target
