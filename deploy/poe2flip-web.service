[Unit]
Description=PoE2 Flip Assistant - web (Next.js)
Wants=poe2flip-coach.service
After=network.target poe2flip-coach.service

[Service]
Type=simple
User=poe2flip
Group=poe2flip
WorkingDirectory=/opt/poe2flip/current
# Product-only secrets + config live here (chmod 600). Coach uses a separate allowlist.
# Standalone TypeScript scripts (db:migrate, addUser) also load this file via dotenv.
EnvironmentFile=/opt/poe2flip/.env.local
# Release-managed non-secret policy overrides legacy timeout values safely.
EnvironmentFile=/opt/poe2flip/current/deploy/runtime-timeouts.env
# Release-local, non-secret provenance generated by deploy.sh. Follows the current symlink.
EnvironmentFile=/opt/poe2flip/current/.release.env
Environment=NODE_ENV=production
Environment=PORT=3000
Environment=PATH=/usr/bin:/usr/local/bin
ExecStart=/usr/bin/npm run start -- --hostname 127.0.0.1
Restart=on-failure
RestartSec=5

[Install]
WantedBy=multi-user.target
