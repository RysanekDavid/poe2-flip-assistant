[Unit]
Description=Monthly PoE2 Flip SQLite VACUUM (low-traffic window, after the nightly backup)

[Timer]
OnCalendar=*-*-01 04:30:00
# No Persistent=: a catch-up run right after a reboot would VACUUM at a random, possibly busy
# hour; skipping one month only leaves the freelist a little larger until the next 1st.

[Install]
WantedBy=timers.target
