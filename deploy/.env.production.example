# Copy to /opt/poe2flip/.env.local (NOT .env.production — the standalone scripts load .env.local
# via dotenv, and systemd reads the same file). Fill secrets, then `chmod 600 .env.local`.
# Generate each secret ON THE BOX (never paste secrets into chat / commits):
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"

NODE_ENV=production

# --- core ---
LEAGUE_NAME=Runes of Aldur
# Absolute path so the systemd services (web + poller) agree regardless of cwd.
DB_PATH=/opt/poe2flip/data/poe2flip.db

# --- auth & encryption (REQUIRED in production — the app throws without them) ---
# AUTH_SECRET: HMAC key for session cookies.  SECRET_KEY: AES key for encrypting stored POESESSIDs.
# Use TWO DIFFERENT fresh values.
AUTH_SECRET=
SECRET_KEY=

# Owner account (seeded as id=1 on first run). Set a password so it isn't a random temp one.
OWNER_NAME=Davosso
OWNER_PASSWORD=

# --- internal AI Coach ---
# Coach binds only to localhost:8000 and is reached through the authenticated Next.js proxy.
# Add these values directly on the server; never commit or paste API keys into chat.
OPENAI_API_KEY=
TAVILY_API_KEY=
COACH_THREAD_SECRET=
COACH_API_URL=http://127.0.0.1:8000
COACH_TIMEOUT_MS=90000
COACH_CHECKPOINT_DB_PATH=/opt/poe2flip/data/coach-checkpoints.db
COACH_REQUESTS_PER_MINUTE=20
CHAT_MODEL=gpt-5.4-mini
EMBEDDING_MODEL=text-embedding-3-small

# --- ninja market poll (shared, no cookie needed) ---
POLL_INTERVAL_MIN=5
RETENTION_DAYS=30

# --- per-user trade2 background scans ---
# Each user pastes their OWN POESESSID in the in-app Settings tab (stored encrypted) — do NOT
# put a global POESESSID here. These flags just turn the background loops on/off.
HUNT_ENABLED=true
HUNT_SCAN_SEC=30
AUTOSNIPE_ENABLED=false
AUTOSNIPE_INTERVAL_MIN=10
# Per-user net-worth auto-read (0 = off; users still get a manual "read stash" button).
BALANCE_INTERVAL_MIN=0
