[Unit]
Description=PoE2 Flip Assistant - monthly SQLite WAL checkpoint + VACUUM
# Runs beside the live web + poller: waits up to --wait seconds for the write lock and exits
# non-zero (unit failed, visible in systemctl --failed) instead of skipping when it can't get it.

[Service]
Type=oneshot
User=poe2flip
Group=poe2flip
WorkingDirectory=/opt/poe2flip/current
Environment=NODE_ENV=production
Environment=PATH=/usr/bin:/usr/local/bin
EnvironmentFile=/opt/poe2flip/.env.local
UMask=0077
Nice=10
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=full
ExecStart=/opt/poe2flip/current/node_modules/.bin/tsx src/db/maintenanceCli.ts vacuum --wait=60
