{
  "name": "poe2-flip-assistant",
  "version": "0.1.0",
  "private": true,
  "engines": {
    "node": ">=20.18.1"
  },
  "scripts": {
    "dev": "concurrently -n web,poll,coach -c cyan,magenta,yellow \"next dev\" \"tsx watch src/scheduler/poller.ts\" \"uv --cache-dir services/coach/.uv-cache --directory services/coach run uvicorn src.api:app --reload --port 8000\"",
    "dev:web": "next dev",
    "dev:poll": "tsx watch src/scheduler/poller.ts",
    "dev:coach": "uv --cache-dir services/coach/.uv-cache --directory services/coach run uvicorn src.api:app --reload --port 8000",
    "build": "next build",
    "start": "next start",
    "probe": "tsx src/scripts/probe.ts",
    "test:coach": "tsx src/scripts/testCoach.ts && tsx src/scripts/testCoachHistory.ts",
    "test:middleware": "tsx src/scripts/testMiddleware.ts",
    "test:demo-user": "tsx src/scripts/testAddUser.ts",
    "test:demo": "tsx src/scripts/testDemoReadiness.ts",
    "test:deploy-config": "tsx src/scripts/testDeploymentConfig.ts && tsx src/scripts/testDeployShell.ts",
    "test:league": "tsx src/scripts/testLeague.ts && tsx src/scripts/testLeagueMigration.ts",
    "test:user-league": "tsx src/scripts/runWithTestEnv.ts user-league",
    "test:market-league": "tsx src/scripts/runWithTestEnv.ts market",
    "test:rates": "tsx src/scripts/runWithTestEnv.ts rates",
    "test:craft": "tsx src/scripts/runWithTestEnv.ts craft",
    "test:db": "tsx src/scripts/runWithTestEnv.ts db",
    "test:valuation": "tsx src/scripts/testValuation.ts",
    "test:auto-snipe": "tsx src/scripts/testAutoSnipe.ts",
    "test:snipe": "tsx src/scripts/testSnipe.ts && tsx src/scripts/runWithTestEnv.ts snipe-db",
    "capture:trade2-fixture": "tsx src/scripts/captureTrade2Fixture.ts",
    "scrape:builds": "tsx src/scripts/scrapeBuilds.ts",
    "sync:poe2-data": "tsx src/scripts/syncPoe2GameData.ts",
    "verify:poe2-data": "tsx src/scripts/syncPoe2GameData.ts --verify",
    "patch:sync": "tsx src/scripts/syncPatchNotes.ts",
    "patch:review": "tsx src/scripts/reviewPatch.ts",
    "test:patch": "tsx src/scripts/testPatchNotes.ts",
    "db:migrate": "tsx src/db/migrate.ts",
    "lint": "tsx src/scripts/lintPolicy.ts",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "axios": "^1.7.0",
    "better-sqlite3": "^11.0.0",
    "bottleneck": "^2.19.5",
    "cheerio": "^1.2.0",
    "date-fns": "^3.0.0",
    "dotenv": "^16.4.0",
    "driver.js": "^1.5.0",
    "lucide-react": "^1.21.0",
    "next": "^15.0.0",
    "node-cron": "^3.0.3",
    "node-notifier": "^10.0.1",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "recharts": "^2.12.0",
    "zod": "^3.23.0"
  },
  "devDependencies": {
    "@types/better-sqlite3": "^7.6.0",
    "@types/node": "^20.14.0",
    "@types/node-cron": "^3.0.11",
    "@types/node-notifier": "^8.0.5",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "autoprefixer": "^10.4.0",
    "concurrently": "^8.2.2",
    "playwright": "^1.61.1",
    "postcss": "^8.4.0",
    "tailwindcss": "^3.4.0",
    "tsx": "^4.16.0",
    "typescript": "^5.5.0"
  }
}
